# ==============================================================================
# AABHA CLOTHING — Production & Deployment Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Highly Recommended for Vercel Live Deployment)
# ------------------------------------------------------------------------------
# PostgreSQL Connection String (Supabase / Neon / Vercel Postgres / AWS RDS).
# Without this, the app runs on local data/*.json fallback. On Vercel's serverless
# runtime, a real database ensures live orders and product updates persist permanently.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 2. SECURITY & JWT AUTHENTICATION (Recommended)
# ------------------------------------------------------------------------------
# Secret key used to sign and verify Admin and Customer JWT tokens.
# Generate a strong 32+ character random string (e.g. openssl rand -hex 32).
# If omitted, the app uses built-in development secret: 'aabha_luxury_admin_jwt_secret_2026'
ADMIN_JWT_SECRET="aabha_8f3d9b1c7a4e2f6051b8c3d9e7a2f4b61c8d0e2a4f6b8c0d2e4a6f8b0c2d4e6"

# ------------------------------------------------------------------------------
# 3. MAIL & ORDER NOTIFICATIONS (Resend / SendGrid / Custom SMTP)
# ------------------------------------------------------------------------------
# Free Resend API key from https://resend.com (3,000 free emails/month, zero setup).
# When set, customers receive branded HTML order receipts & dispatch notices.
RESEND_API_KEY="re_123456789_abcdefg"

# Verified sender email address (e.g., your domain or Resend testing domain)
EMAIL_FROM="AABHA CLOTHING <onboarding@resend.dev>"

# Store Owner personal email: Receives instant alert whenever a customer places an order
ADMIN_NOTIFICATION_EMAIL="owner@aabhaclothing.com"

# ------------------------------------------------------------------------------
# 4. APPLICATION DOMAIN & URLS (Optional)
# ------------------------------------------------------------------------------
# Live public canonical URL of the deployed storefront on Vercel.
# Used for metadata, canonical SEO tags, and external WhatsApp customer links.
APP_URL="https://aabha-clothing.vercel.app"
NEXT_PUBLIC_APP_URL="https://aabha-clothing.vercel.app"

# ------------------------------------------------------------------------------
# 5. OPTIONAL AI & MEDIA EXPANSIONS (Optional)
# ------------------------------------------------------------------------------
# Google Gemini API key if utilizing AI features via @google/genai.
GEMINI_API_KEY=""
